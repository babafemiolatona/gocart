ENV=development
GO_MODE=development

# Server
SERVER_PORT=8080

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gocartdb
DB_SSL_MODE=disable

# JWT
JWT_SECRET=change-this-secret-before-production
JWT_EXPIRY=24h
TOKEN_DURATION_MINUTES=60

# Webhook (shared secret for payment provider callbacks)
WEBHOOK_SECRET=change-this-webhook-secret

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Seed admin (optional; if unset, no admin is seeded)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gocart
MINIO_USE_SSL=false
